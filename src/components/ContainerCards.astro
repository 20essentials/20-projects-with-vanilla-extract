const lightness = '51.37%';

const cardsWithColors = arrayCards.map(card => {
  const hue = (Math.random() * 360).toFixed(2);
  const saturation = (Math.random() * 100).toFixed(2) + '%';
  return { ...card, hue, saturation };
});
---

<div class='cards'>
  {
    cardsWithColors.map(({ id, repo, localImage, title, hue, saturation }) => (
      <div
        class='card'
        style={`--hue:${hue}; --saturation:${saturation}; --lightness:${lightness}`}
      >
        <h3 class='card__heading'>{title}</h3>
        <a class='container-img' href={repo}>
          <img src={baseUrl(localImage)} alt={title} />
        </a>
      </div>
    ))
  }

  <div class='overlay' aria-hidden='true'>
    {
      cardsWithColors.map(({ id, repo, localImage, title, hue, saturation }) => (
        <div
          class='card card-overlay'
          style={`--hue:${hue}; --saturation:${saturation}; --lightness:${lightness}`}
        >
          <h3 class='card__heading'>{title}</h3>
          <a class='container-img' href={repo}>
            <img src={baseUrl(localImage)} alt={title} />
          </a>
        </div>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cardsContainer = document.querySelector('.cards');
    const overlay = document.querySelector('.overlay');

    if (!cardsContainer || !overlay) {
      console.error('No se encontraron los elementos .cards o .overlay');
      return;
    }

    const pxToVmax = px => {
      const vmax = Math.max(window.innerWidth, window.innerHeight);
      return `${(px / vmax) * 100}vmax`;
    };

    const onPointerMove = e => {
      const rect = cardsContainer.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      overlay.style.setProperty('--opacity', '1');
      overlay.style.setProperty('--x', pxToVmax(x));
      overlay.style.setProperty('--y', pxToVmax(y));
    };

    const onPointerLeave = () => {
      overlay.style.setProperty('--opacity', '0');
    };

    cardsContainer.addEventListener('pointermove', onPointerMove);
    cardsContainer.addEventListener('pointerleave', onPointerLeave);
  });
</script>

<style>
  .cards {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));
    place-content: center;
    place-items: center;
  }

  .card {
    --hsl: var(--hue), var(--saturation), var(--lightness);
    aspect-ratio: 16 / 9;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-items: start;
    color: #eceff1;
    gap: 1.2vmax;
    background-color: #2b2b2b;
    border: 0.1vmax solid #eceff133;
    border-radius: 0.9vmax;
    cursor: pointer;
    transition: background 400ms ease;
    min-width: 16vmax;
    width: 100%;
    padding: 1.2vmax;
    background: hsla(var(--hsl), 0.1);
    display: flex;
    flex-direction: column;

    &.card-overlay {
      * {
        opacity: 0;
      }
    }

    .container-img {
      aspect-ratio: 16 / 9;
      display: flex;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }

  .card:hover {
    --lightness: 95%;
  }

  .card__heading {
    font-size: 1.1vmax;
    font-weight: 600;
    font-family: Arial, Helvetica, sans-serif;
    display: flex;
  }

  .overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    opacity: var(--opacity, 0);
    mask: radial-gradient(
      25rem 25rem at var(--x) var(--y),
      #000 1%,
      transparent 50%
    );
    transition:
      400ms mask ease,
      opacity 400ms ease;
    will-change: mask;

    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));
    place-content: center;
    place-items: center;
  }

  .overlay .card {
    background-color: hsla(var(--hsl), 0.15);
    border-color: hsla(var(--hsl), 1);
    box-shadow: 0 0 0 0.0625vmax inset hsl(var(--hsl));
    border-radius: 0.9vmax;

    .container-img {
      aspect-ratio: 16 / 9;
      display: flex;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
